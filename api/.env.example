# copy this file to .env and fill in the values

PORT=3000

# Groq (https://console.groq.com/keys), free tier is enough for testing
GROQ_API_KEY=
# list of available models: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# how much the model "thinks" before answering: low is enough for chat
# (gpt-oss: low | medium | high, qwen: none | default)
GROQ_REASONING_EFFORT=low

# place search (https://my.locationiq.com), free tier: 5,000 requests per day
LOCATIONIQ_API_KEY=

# local PostgreSQL (user postgres, database walksy)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/walksy?schema=public"

# signs login tokens: a long random secret, e.g. from
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d
