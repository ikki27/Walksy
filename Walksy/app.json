{
  "expo": {
    "name": "Walksy",
    "slug": "Walksy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "walksy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ikki27.walksy"
    },
    "android": {
      "package": "com.ikki27.walksy",
      "adaptiveIcon": {
        "backgroundColor": "#FBE3D6",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBE3D6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c45cc29c-9327-419f-99bc-16f2c88077a5"
      }
    },
    "owner": "ikki27"
  }
}
